# Required in production
ADMIN_PASSWORD=choose-a-long-password
# Database (Turso). Without these the votes are kept in data/db.json, which Render wipes on every deploy.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
# Render
TRUST_PROXY=1
RATE_LIMIT=1200
# Optional: PROXY_HOPS=2, APP_URL=https://your-app.onrender.com (QR code target; Render sets RENDER_EXTERNAL_URL itself)
